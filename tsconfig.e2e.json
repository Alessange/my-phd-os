{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "tests/e2e/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
