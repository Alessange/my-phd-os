{
  "name": "my-phd-os",
  "version": "0.1.3",
  "description": "My PhD OS — a local-first desktop app for a PhD student's calendar, deadlines, long-term timeline, and habits.",
  "main": "./out/main/index.js",
  "author": "My PhD OS contributors",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/my-phd-os/my-phd-os",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "start": "node scripts/with-electron-env.mjs electron-vite preview",
    "dev": "node scripts/with-electron-env.mjs electron-vite dev",
    "build": "npm run typecheck && node scripts/with-electron-env.mjs electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/with-electron-env.mjs playwright test",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/with-electron-env.mjs electron-builder --dir",
    "build:win": "npm run build && node scripts/with-electron-env.mjs electron-builder --win",
    "build:mac": "npm run build && node scripts/with-electron-env.mjs electron-builder --mac",
    "build:linux": "npm run build && node scripts/with-electron-env.mjs electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "ical.js": "^2.2.1",
    "luxon": "^3.7.2",
    "rrule": "^2.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fullcalendar/core": "~6.1.21",
    "@fullcalendar/daygrid": "~6.1.21",
    "@fullcalendar/interaction": "~6.1.21",
    "@fullcalendar/list": "~6.1.21",
    "@fullcalendar/luxon3": "~6.1.21",
    "@fullcalendar/react": "~6.1.21",
    "@fullcalendar/rrule": "~6.1.21",
    "@fullcalendar/timegrid": "~6.1.21",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.41.0",
    "playwright": "^1.62.1",
    "prettier": "^3.7.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
